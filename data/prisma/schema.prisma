// LOCUS Explorer — Prisma schema
// Postgres (local via docker-compose; Prisma Postgres in production).
generator client {
  provider      = "prisma-client-js"
  // Native engine for local dev + debian-openssl-3.0.x for the Linux container
  // (silences the "failed to detect libssl/openssl" warning in Docker).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One LOCUS-v1 law chunk (full record). ~2.2M rows in production.
model Law {
  id                     Int     @id @default(autoincrement())
  header                 String?
  content                String  @db.Text
  isSubstantive          Boolean @map("is_substantive")
  function               String?
  topic                  String?
  sourceJurisdictionType String? @map("source_jurisdiction_type")
  state                  String
  city                   String?
  county                 String?
  enforcementDiscretion  Float   @map("enforcement_discretion")
  opacity                Float
  paternalism            Float
  problemSalience        Float   @map("problem_salience")

  // Full-text search column: a generated tsvector created in the migration SQL
  // (Prisma cannot express GENERATED columns). Tracked here as Unsupported so
  // migrations stay in sync; queried via $queryRaw with websearch_to_tsquery.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// LOCUS-Fines annotation, when the supplement's model read this row.
  fines LawFine?

  @@index([state])
  @@index([state, county])
  @@index([state, city])
  @@index([function])
  @@index([topic])
  @@index([isSubstantive])
  @@index([opacity])
  @@index([enforcementDiscretion])
  @@index([paternalism])
  @@index([problemSalience])
  @@index([searchVector], type: Gin)
  // Phase 2 performance indexes (see migration 20260102000000_perf_search_indexes).
  // Trigram GIN powering the `county ILIKE '%x%'` / `city ILIKE '%x%'` filters.
  @@index([county(ops: raw("gin_trgm_ops"))], type: Gin, map: "laws_county_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "laws_city_trgm_idx")
  // Composite (state, axis) + (state, isSubstantive): filter by state then
  // sort/filter on a score without a separate sort over the per-state slice.
  @@index([state, opacity], map: "laws_state_opacity_idx")
  @@index([state, enforcementDiscretion], map: "laws_state_enforcement_discretion_idx")
  @@index([state, paternalism], map: "laws_state_paternalism_idx")
  @@index([state, problemSalience], map: "laws_state_problem_salience_idx")
  @@index([state, isSubstantive], map: "laws_state_is_substantive_idx")
  @@map("laws")
}

/// Pre-computed aggregates for fast map + dashboard rendering.
/// `level` = 'national' | 'state' | 'county'.
model Jurisdiction {
  id                       Int     @id @default(autoincrement())
  level                    String
  state                    String?
  county                   String?
  name                     String
  lawCount                 Int     @map("law_count")
  substantiveCount         Int     @map("substantive_count")
  avgOpacity               Float   @map("avg_opacity")
  avgEnforcementDiscretion Float   @map("avg_enforcement_discretion")
  avgPaternalism           Float   @map("avg_paternalism")
  avgProblemSalience       Float   @map("avg_problem_salience")
  // Per-axis [min,max] bounds (used for slider domains + color scale).
  // Populated on the single level='national' row.
  bounds                   Json?

  @@unique([level, state, county])
  @@index([level])
  @@map("jurisdictions")
}

/// LOCUS-Fines penalty annotation for one law (`data/build-fines.ts`).
///
/// Only rows the supplement actually sent to its model (`annotation_source =
/// 'LLM'`) are stored — every dollar amount and every model judgement lives on
/// those rows. A missing row therefore means "not read by the model", which is
/// NOT the same as "this law has no penalty". Rebuilt from scratch whenever
/// `laws` is re-seeded, since law ids are not stable across a `--fresh` load.
model LawFine {
  id    Int @id @default(autoincrement())
  lawId Int @unique @map("law_id")
  law   Law @relation(fields: [lawId], references: [id], onDelete: Cascade)

  // Denormalized jurisdiction identity (verbatim LOCUS slugs) so per-place
  // aggregates do not have to join back to the 2.2M-row `laws` table.
  state  String
  city   String?
  county String?

  /// First 16 hex chars of sha1(laws.content) — the supplement's join key.
  contentSha1      String @map("content_sha1")
  /// Provenance from the source dataset; always 'LLM' for stored rows.
  annotationSource String @map("annotation_source")

  fineRelevant  Boolean @map("fine_relevant")
  /// 'code_general' | 'chapter_general' | 'specific'
  penaltyScope  String? @map("penalty_scope")
  /// 'amounts_here' | 'cross_reference' | 'implicit'
  penaltyStated String? @map("penalty_stated")
  /// 'fixed' | 'fluid'
  fineStructure String? @map("fine_structure")

  // Dollar amounts, double precision to round-trip the source float64 exactly
  // (418 values are non-integer; the largest is 5,000,000).
  fixedAmount               Float? @map("fixed_amount")
  minAmount                 Float? @map("min_amount")
  maxAmount                 Float? @map("max_amount")
  firstViolationAmount      Float? @map("first_violation_amount")
  secondViolationAmount     Float? @map("second_violation_amount")
  subsequentViolationAmount Float? @map("subsequent_violation_amount")
  /// min / max across all six amount fields — the section's true penalty span.
  effectiveMin              Float? @map("effective_min")
  effectiveMax              Float? @map("effective_max")

  perDayViolation Boolean  @map("per_day_violation")
  jailMentioned   Boolean  @map("jail_mentioned")
  /// 'criminal' | 'civil' | 'both'
  penaltyNature   String?  @map("penalty_nature")
  /// 'fragment_incomplete' | 'table_fragment' | 'not_ordinance_text'
  extractionFlag  String?  @map("extraction_flag")
  /// false when an amount could not be found in the source text and was dropped.
  grounded        Boolean?

  @@index([state])
  @@index([penaltyStated])
  @@index([effectiveMax])
  @@map("law_fines")
}

/// Per-place LOCUS-Fines aggregates behind the Penalties map layer
/// (`data/build-fines.ts`).
///
/// A sibling table rather than columns on `Jurisdiction` / `CountyFill`:
/// `data/build-city-county.ts` rebuilds those with DELETE + re-INSERT, so
/// penalty columns there would be wiped by an unrelated `pnpm build:city-county`.
/// `place` is COALESCE(city, county), which equals `CountyFill.sourcePlace`.
model PlacePenalty {
  id Int @id @default(autoincrement())

  /// 'national' (state + place null) | 'state' (place null) | 'place'
  level String
  state String?
  place String?

  /// Sections the model read here — the denominator for every share.
  penaltySections Int    @map("penalty_sections")
  amountSections  Int    @map("amount_sections")
  jailSections    Int    @map("jail_sections")
  perDaySections  Int    @map("per_day_sections")
  /// null when too few amount sections back it (see PENALTY_MEDIAN_MIN).
  medianFine      Float? @map("median_fine")

  /// Average problem salience inside the read set, split by whether the
  /// section names an amount. The measurable link to the four axes.
  salienceAmount   Float? @map("salience_amount")
  salienceNoAmount Float? @map("salience_no_amount")

  @@unique([level, state, place])
  @@index([state])
  @@map("place_penalties")
}

/// Resumability for the full-dataset seed: one row per completed parquet shard.
model SeedCheckpoint {
  id          Int      @id @default(autoincrement())
  shard       String   @unique
  rowsLoaded  Int      @map("rows_loaded")
  completedAt DateTime @default(now()) @map("completed_at")

  @@map("seed_checkpoints")
}

/// Census 2020 place join for LOCUS city slugs. Additive lookup — does not
/// rewrite `laws.city` / `laws.county`. Multi-county places are flagged and
/// never used as a map fill.
model CityCounty {
  id          Int     @id @default(autoincrement())
  state       String
  city        String
  countyFips  String? @map("county_fips")
  countyName  String? @map("county_name")
  atlasKey    String? @map("atlas_key")
  matchRule   String  @map("match_rule")
  multiCounty Boolean @map("multi_county")
  countyCount Int     @map("county_count")

  @@unique([state, city])
  @@index([state])
  @@index([countyFips])
  @@map("city_county")
}

/// Map-layer aggregates. Sibling to `jurisdictions` so city stand-ins do not
/// collide with unique `(level, state, county)`. `source` is `county` | `city`.
model CountyFill {
  id                       Int     @id @default(autoincrement())
  state                    String
  fips                     String?
  source                   String
  sourcePlace              String  @map("source_place")
  county                   String?
  name                     String
  lawCount                 Int     @map("law_count")
  substantiveCount         Int     @map("substantive_count")
  avgOpacity               Float   @map("avg_opacity")
  avgEnforcementDiscretion Float   @map("avg_enforcement_discretion")
  avgPaternalism           Float   @map("avg_paternalism")
  avgProblemSalience       Float   @map("avg_problem_salience")

  @@unique([source, state, sourcePlace])
  @@index([state])
  @@index([fips])
  @@map("county_fills")
}
