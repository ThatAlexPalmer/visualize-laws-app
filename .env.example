# ---------------------------------------------------------------------------
# visualizelaws.com environment
# Copy to `.env` and adjust as needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# Local development (matches docker-compose.yml). `pnpm db:up` starts this DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locus?schema=public"
# Prisma uses DIRECT_URL for migrations. Locally it is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/locus?schema=public"

# Production (Prisma Postgres via Vercel Storage; Neon is the documented fallback):
#   - Vercel gets ONLY the POOLED connection string, as DATABASE_URL, scoped to
#     the Production environment (keep it off Preview/Development, or use a
#     separate preview database).
#   - DIRECT_URL is the NON-POOLING string. Keep it LOCAL ONLY (this file / your
#     .env) for `pnpm prisma:deploy` + `pnpm seed` from your laptop. It does NOT
#     need to be set in Vercel.

# Rows that `docker compose up` sample-seeds on first boot (only when the DB is
# empty). Set to 0 to load the ENTIRE ~2.2M-row corpus instead (downloads
# ~1.77 GB; slower first boot). No effect on host `pnpm seed`.
SEED_LIMIT="25000"

