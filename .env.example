# ---------------------------------------------------------------------------
# visualizelaws.com — environment template
#
# Convention (this is the ONLY env file committed to git):
#   .env.local  -> local development (localhost Postgres). Copy this file to it.
#   .env.prod   -> remote admin only: migrate/seed the production DB from your
#                  laptop. Holds the Prisma Postgres DIRECT connection.
#
# Setup:
#   cp .env.example .env.local          # local dev (defaults below just work)
#   # create .env.prod when you need to migrate/seed production (see below)
#
# Both .env.local and .env.prod are gitignored. Next.js auto-loads .env.local;
# the DB/seed scripts load the right file via dotenv-cli:
#   pnpm prisma:deploy   / pnpm seed        -> .env.local
#   pnpm prisma:deploy:prod / pnpm seed:prod -> .env.prod
# ---------------------------------------------------------------------------

# === .env.local — local development ========================================
# Matches docker-compose.yml; `pnpm db:up` starts this Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locus?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/locus?schema=public"

# Rows `docker compose up` sample-seeds on first boot (empty DB only).
# 0 = the full ~2.2M-row corpus. No effect on host `pnpm seed`.
SEED_LIMIT="25000"

# Optional: tweet URL for the LOCUS attribution link in the footer.
# NEXT_PUBLIC_TWEET_URL="https://x.com/<handle>/status/<id>"

# === .env.prod — remote admin (migrate + seed production) ===================
# Use the Prisma Postgres DIRECT (non-pooling) postgres:// URL for BOTH vars:
# `prisma migrate` and the pg COPY seeder need a direct TCP connection, NOT the
# prisma+postgres:// Accelerate URL. Never commit this, and never set DIRECT_URL
# in Vercel (Vercel Production gets only the pooled DATABASE_URL).
#   DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
#   DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# === Future phase (Score New Law inference) — unused in Phase 1 =============
# HF_INFERENCE_BASE_URL=""
# HF_TOKEN=""
