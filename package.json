{
  "name": "visualize-laws-app",
  "version": "1.2.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Explore the complete LOCUS-v1 corpus of 2.2M U.S. local laws: search, filter, and an interactive canvas map.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "dotenv -e .env.local -- tsx data/seed.ts",
    "seed:prod": "dotenv -e .env.prod -- tsx data/seed.ts",
    "build:city-county": "dotenv -e .env.local -- tsx data/build-city-county.ts",
    "build:city-county:prod": "dotenv -e .env.prod -- tsx data/build-city-county.ts",
    "build:fines": "dotenv -e .env.local -- tsx data/build-fines.ts",
    "build:fines:prod": "dotenv -e .env.prod -- tsx data/build-fines.ts",
    "test": "tsx --test data/cityCounty.test.ts data/fines.test.ts components/map/counties.test.ts components/jurisdiction/placeLookup.test.ts data/queries/laws.test.ts",
    "prisma:generate": "prisma generate --schema data/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev --schema data/prisma/schema.prisma",
    "prisma:deploy": "dotenv -e .env.local -- prisma migrate deploy --schema data/prisma/schema.prisma",
    "prisma:deploy:prod": "dotenv -e .env.prod -- prisma migrate deploy --schema data/prisma/schema.prisma",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:studio": "dotenv -e .env.local -- prisma studio --schema data/prisma/schema.prisma",
    "db:studio:prod": "dotenv -e .env.prod -- prisma studio --schema data/prisma/schema.prisma",
    "up": "docker compose up",
    "up:build": "docker compose up --build",
    "up:full": "SEED_LIMIT=0 docker compose up",
    "postinstall": "prisma generate --schema data/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx data/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.15.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "pg-copy-streams": "^6.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.5.3",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@dsnp/parquetjs": "^1.8.9",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/topojson-client": "^3.1.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "hyparquet": "^1.29.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "nanoid@^3": "3.3.18",
      "js-yaml": ">=4.3.1",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^5": "5.0.9"
    }
  }
}
