{
  "name": "visualize-laws-app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Explore the complete LOCUS-v1 corpus of 2.2M U.S. local laws: search, filter, and an interactive canvas map.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx data/seed.ts",
    "prisma:generate": "prisma generate --schema data/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema data/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema data/prisma/schema.prisma",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "up": "docker compose up",
    "up:build": "docker compose up --build",
    "postinstall": "prisma generate --schema data/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx data/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.15.0",
    "next": "^15.1.3",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.14",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@dsnp/parquetjs": "^1.8.6",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
